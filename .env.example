# Copia este archivo como .env y cambia los valores (docker compose lo lee solo).
# .env está en .gitignore: nunca subas tus contraseñas al repositorio.

# Puerto del ordenador donde se abre la app: http://localhost:8080
APP_PORT=8080

# true solo en desarrollo: muestra los detalles de los errores
APP_DEBUG=false

# true si hay un proxy inverso delante (Nginx, Traefik…) que sirve la web por HTTPS
TRUST_PROXY=false

# Clave para cifrar las URLs de los calendarios de Moodle y Classroom. Genera una con:
#   php -r "echo 'base64:' . base64_encode(random_bytes(32)), PHP_EOL;"
# No la cambies después de conectar calendarios (habría que volver a conectarlos).
APP_KEY=

# Usuario y contraseñas de MySQL. Solo se aplican la primera vez que arranca la base
# de datos (con el volumen vacío); para cambiarlos después: docker compose down -v
DB_USER=studytrack
DB_PASS=cambia-esta-contraseña
DB_ROOT_PASS=cambia-tambien-esta

# El resto de variables que lee la app las fija docker-compose.yml:
#   DB_HOST=db, DB_PORT=3306 (el servicio de MySQL)
#   DB_NAME=studytrack (los .sql de sql/ crean y usan esa base de datos)
# Fuera de Docker (XAMPP, Laragon…) también se pueden definir en el entorno;
# ver config/database.php.
