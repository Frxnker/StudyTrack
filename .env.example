# Copia este archivo como .env y cambia los valores (docker compose lo lee solo).
# .env está en .gitignore: nunca subas tus contraseñas al repositorio.

# Puerto del ordenador donde se abre la app: http://localhost:8080
APP_PORT=8080

# true solo en desarrollo: muestra los detalles de los errores
APP_DEBUG=false

# true si hay un proxy inverso delante (Nginx, Traefik…) que sirve la web por HTTPS
TRUST_PROXY=false

# Contraseñas de MySQL (solo se aplican la primera vez, con el volumen vacío)
DB_PASS=cambia-esta-contraseña
DB_ROOT_PASS=cambia-tambien-esta
