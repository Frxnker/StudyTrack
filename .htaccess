# StudyTrack · reglas de Apache para XAMPP y Laragon (necesita mod_rewrite)
#
# Solo public/ es accesible desde la web. Esta regla hace que la carpeta del proyecto
# funcione como si fuera public/: http://localhost/StudyTrack/tasks.php sirve
# public/tasks.php, y cualquier otra ruta (config/, models/, sql/, .git…) acaba
# buscándose dentro de public/, donde no existe → 404.
#
# Si puedes configurar el servidor (Docker, un VirtualHost propio, php -S … -t public),
# apunta la raíz web directamente a public/ y este archivo deja de usarse.

Options -Indexes

RewriteEngine On
RewriteRule ^(.*)$ public/$1 [L]
