# StudyTrack · reglas de Apache (XAMPP, Laragon y la imagen de Docker)

# No mostrar el contenido de las carpetas
Options -Indexes

# Solo se accede directamente a las páginas de la raíz y a css/, js/ y assets/.
# Las carpetas internas (configuración, modelos, plantillas, SQL, cron…) responden 404.
RedirectMatch 404 /(config|includes|models|views|sql|cron)(/|$)
RedirectMatch 404 /(\.git|\.env|\.docker|Dockerfile|docker-compose\.yml|README\.md)
